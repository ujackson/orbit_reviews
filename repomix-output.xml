    whatsapp: '#2D9B75',   // Desaturated by 15%
    instagram: '#C94C8A',  // Desaturated by 15%
    sms: '#8B6FD9',        // Desaturated by 15%
  },
  
  // ============================================================================
  // SEMANTIC SURFACE TOKENS - The Four Color Layers
  // ============================================================================
  
