                size="small"
                sx={{
                  fontSize: typography.fontSize.xs,
                  fontWeight: typography.fontWeight.medium,
                  bgcolor: alpha(getRoleColor(user.role), 0.1),
                  color: getRoleColor(user.role),
                  borderRadius: radius.sm,
                  '& .MuiOutline-notchedOutline': {
                    border: 'none',
