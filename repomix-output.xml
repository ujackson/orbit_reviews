      </SettingSection>

      {/* Invite Member Slide Panel */}
      <SlidePanel
        open={invitePanelOpen}
        onClose={() => setInvitePanelOpen(false)}
        title="Invite Team Member"
        subtitle="Send an invitation to join your workspace"
        width={480}
