          "embedding" => Array.new(1024, 0.1),
          "status" => "embedded"
        }
      )
    end
  end

  class SkippedEmbeddingRagClient < FakeRagClient
    def create_embedding(content_type:, content_id:, text:, metadata:)
      OrbitAi::Client::Result.new(
        success: true,
        data: {
          "content_id" => content_id,
          "embedding_dimensions" => 0,
