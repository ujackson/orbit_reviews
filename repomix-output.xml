            <Box sx={{ display: 'flex', alignItems: 'center', gap: spacing[12], p: spacing[16], borderRadius: radius.base, bgcolor: alpha(color.neutral[900], 0.02), border: `1px solid ${alpha(color.neutral[900], 0.04)}` }}>
